# ---------------------------------------------------------------------------
# ADWOL PIA Automation System — environment configuration
# Copy to `.env` for local development. NEVER commit `.env`.
# The config loader (src/Support/Env.php) fails fast if a REQUIRED key is
# missing or blank, so every key below without a default must be set.
# ---------------------------------------------------------------------------

# App -----------------------------------------------------------------------
APP_NAME="ADWOL PIA"
APP_ENV=local                     # local | staging | production
APP_DEBUG=true                    # MUST be false in production
APP_URL=http://127.0.0.1:8080
APP_TIMEZONE=UTC                  # storage is always UTC (brief §4); do not change

# Security keys -----------------------------------------------------------
# Generate with:  php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
APP_KEY=                          # 64 hex chars — general app secret / CSRF key base
JWT_SECRET=                       # 64 hex chars — HS256 signing key (Phase 2)
HMAC_DOCUMENT_KEY=                # 64 hex chars — document integrity HMAC (D7, Phase 6)

# Database ----------------------------------------------------------------
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=adwol_pia_dev
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# Auth / session (Phase 2) ---------------------------------------------------
JWT_ISSUER=pia-api               # `iss` claim; tokens from other issuers are rejected
JWT_ACCESS_TTL=900               # seconds — 15 minutes
JWT_REFRESH_TTL=604800           # seconds — 7 days (aligns with D4 re-auth rule)
OFFLINE_REAUTH_MAX_DAYS=7        # D4: online login required at least this often
AUTH_RATE_LIMIT_MAX=10           # requests per window per IP on /api/auth/*
AUTH_RATE_LIMIT_WINDOW=900       # seconds

# Argon2id parameters (Phase 2) — tuned conservatively for shared hosting
ARGON2_MEMORY_KIB=65536          # 64 MB
ARGON2_TIME_COST=4
ARGON2_THREADS=1

# Offline unlock PIN (Phase 8 / D4) — the PWA verifies this Argon2id hash locally
PIN_MIN_LENGTH=4
PIN_MAX_LENGTH=8

# Storage ----------------------------------------------------------------
STORAGE_PATH=storage
ATTACHMENT_MAX_BYTES=10485760    # 10 MB per attachment (revisit in Phase 4)

# Logging ----------------------------------------------------------------
LOG_LEVEL=debug                  # debug | info | notice | warning | error
LOG_CHANNEL=app

# Office workflow (Phase 3)
NOTICE_WINDOW_HOURS=72           # notice_deadline = requested_at + N hours (assumption A14 / Q9)

# Compliance tracking (Phase 7)
COMPLIANCE_GRACE_HOURS=24        # an inspection is "missed" this many hours after scheduled_at if still un-synced (A34 / Q9)
COMPLIANCE_STRIKE_THRESHOLD=3    # consecutive months with a miss before alert_triggered flips on

# Document letterhead (Phase 6) — the fresh-install DEFAULT only. An admin can
# edit the live value from /console/settings without a redeploy
# (company_settings table); these are just what a new install starts with.
PIA_COMPANY_NAME="ADWOL Investments and Services"
PIA_COMPANY_ADDRESS=""
PIA_REPRESENTATIVE_TITLE="Authorised Representative"

# Outgoing email (optional). Leave MAIL_HOST empty to run without email: the
# app works fully, but "Forgot password?" and the daily digest are switched off.
# Credentials stay here in .env on purpose — they are secrets, so they are not
# editable from the console.
MAIL_HOST=
MAIL_PORT=587
MAIL_ENCRYPTION=tls              # tls (STARTTLS, port 587) | ssl (implicit TLS, port 465) | none
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="ADWOL PIA"
