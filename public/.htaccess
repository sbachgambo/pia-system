# Front-controller routing for Apache (cPanel-style shared hosting).
# All non-file requests are handed to public/index.php.

<IfModule mod_rewrite.c>
    RewriteEngine On

    # If the request maps to a real file or directory, serve it as-is
    # (static PWA assets in later phases).
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Everything else -> front controller.
    RewriteRule ^ index.php [QSA,L]
</IfModule>

# Never serve dotfiles (e.g. a stray .env if the layout is misconfigured).
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# Security headers (brief §7 / Phase 9).
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "no-referrer"

    # No external CDN/font/script host is used anywhere in this app (console,
    # API, PWA, and generated documents are all same-origin, self-hosted —
    # argon2-browser and mPDF's assets are vendored, not fetched at runtime),
    # so a same-origin-only policy costs nothing. 'wasm-unsafe-eval' is needed
    # for the PWA's offline-PIN check (WebAssembly.instantiate, brief §6/A7).
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"

    # HSTS — DO NOT enable until HTTPS is confirmed working end-to-end on the
    # real host (Q8, still open). Turning this on before TLS is verified can
    # lock a browser out of the site for the max-age duration. Once confirmed,
    # uncomment (start with a short max-age, raise it after it's proven solid):
    #   Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
</IfModule>

# PWA (Phase 8) — correct MIME types for the service worker's precache.
<IfModule mod_mime.c>
    AddType application/wasm            .wasm
    AddType application/manifest+json   .webmanifest
</IfModule>

# The service worker must be allowed to control the whole /app/ scope and
# must never be served stale.
<IfModule mod_headers.c>
    <FilesMatch "sw\.js$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Service-Worker-Allowed "/app/"
    </FilesMatch>
</IfModule>
