{
    "name": "adwol/pia-automation-system",
    "description": "Internal Preshipment Inspection Agency (PIA) automation system: consignment intake, inspection capture (offline PWA), CCI/CRF/IDR document generation, compliance tracking, and statutory returns.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.1",
        "ext-fileinfo": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "bacon/bacon-qr-code": "^3.1",
        "lcobucci/jwt": "^5.3",
        "monolog/monolog": "^3.7",
        "mpdf/mpdf": "^8.2",
        "php-di/php-di": "^7.0",
        "phpmailer/phpmailer": "*",
        "ramsey/uuid": "^4.7",
        "robmorgan/phinx": "^0.16.9",
        "slim/psr7": "^1.7",
        "slim/slim": "^4.14",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "config": {
        "platform": {
            "php": "8.1.0"
        },
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": false
        }
    },
    "scripts": {
        "migrate": "phinx migrate -c phinx.php",
        "rollback": "phinx rollback -c phinx.php -t 0",
        "seed": "phinx seed:run -c phinx.php",
        "test": "phpunit",
        "serve": "php -S 127.0.0.1:8080 -t public",
        "compliance:evaluate": "php bin/evaluate-compliance.php"
    }
}
